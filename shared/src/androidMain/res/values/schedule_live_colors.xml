<?xml version="1.0" encoding="utf-8"?>
<!--
  Status colours for the live card: blue while a class is running, amber between classes.

  The pair carries meaning, not decoration. The bar and the right-hand status text switch together,
  so a glance at the notification tells you which phase you are in without reading the words.
  Amber rather than red because a break is not an alarm.

  Each bar keeps a translucent version of its own hue for the track, so the unfilled part reads as
  part of the same control instead of a separate grey rule.
-->
<resources>
    <color name="schedule_live_accent">#4C8DFF</color>
    <color name="schedule_live_track">#334C8DFF</color>
    <color name="schedule_live_accent_break">#FFB020</color>
    <color name="schedule_live_track_break">#33FFB020</color>
</resources>
