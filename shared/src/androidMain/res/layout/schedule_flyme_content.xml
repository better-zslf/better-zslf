<?xml version="1.0" encoding="utf-8"?>
<!--
  Meizu Flyme live-notification expanded card: what opens when the user taps the pill.

  Information order matches the standard live card (course, status, progress, room), so switching
  between the vendor card and the standard one never changes what the user reads. Four elements
  are deliberate: a determinate ProgressBar sits between the status and the subtitle; code hides
  it (View.GONE) during a countdown, where a percentage would be invented.

  Text colours are intentionally inherited from the host theme: this layout is inflated by Flyme's
  SystemUI, which runs in whatever light/dark mode the user picked. Only the capsule pill pins its
  own colours, because it is drawn on a chrome the app cannot see.

  Mechanism note: the enclosing notification payload is reverse engineered (Meizu publishes no
  documentation for it) and may silently stop working after a Flyme update.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/schedule_flyme_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/schedule_flyme_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/schedule_flyme_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100" />

    <TextView
        android:id="@+id/schedule_flyme_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp" />

</LinearLayout>
