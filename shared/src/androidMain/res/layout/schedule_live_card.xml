<?xml version="1.0" encoding="utf-8"?>
<!--
  Live-notification expanded card shared by every vendor path.

  Three zones, matching the design reference:
    1. title row      course name (left) + remaining time or start clock (right)
    2. progress bar   8dp rounded, only meaningful while in class
    3. detail row     three equal columns: teacher / room / period (in class) or start (between)

  Flyme tints whatever it can from the wallpaper, so colours that must stay readable are set
  from code rather than left to the theme: the title uses the system onSurface colour and the
  right-hand status uses an explicit accent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/schedule_live_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/schedule_live_title_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/schedule_live_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
      Two progress bars, one per phase: the blue one is shown while a class runs, the amber one
      during a break. Only the relevant bar is visible at a time.

      Why two instead of one re-tinted bar: ProgressBar.setProgressTintList is not annotated
      @RemotableViewMethod, so a RemoteViews call to it is dropped by the host exactly like the
      earlier setProgressBar calls were. Colours therefore have to be fixed at inflate time, and
      two views is the only way to have two colours without touching the drawable at runtime.

      Stock style kept: three attempts to customise the drawable each broke worse (see history).
      Only progressTint is set, in XML, which the host applies during inflate and cannot drop.
    -->
    <ProgressBar
        android:id="@+id/schedule_live_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/schedule_live_accent"
        android:progressBackgroundTint="@color/schedule_live_track" />

    <ProgressBar
        android:id="@+id/schedule_live_progress_break"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/schedule_live_accent_break"
        android:progressBackgroundTint="@color/schedule_live_track_break" />

    <!-- Detail row: three equal columns, blank cells simply empty -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_live_label_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/schedule_live_meta_label"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/schedule_live_value_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/schedule_live_title_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_live_label_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/schedule_live_meta_label"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/schedule_live_value_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/schedule_live_title_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_live_label_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/schedule_live_meta_label"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/schedule_live_value_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/schedule_live_title_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
