<?xml version="1.0" encoding="utf-8"?>
<!--
  Flyme live-notification expanded card.

  Three zones, matching the design reference:
    1. title row      course name (left) + remaining time or start clock (right)
    2. progress bar   8dp rounded, only meaningful while in class
    3. detail row     three equal columns: teacher / room / period (in class) or start (between)

  Flyme tints whatever it can from the wallpaper, so colours that must stay readable are set
  from code rather than left to the theme: the title uses the system onSurface colour and the
  right-hand status uses an explicit accent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/schedule_flyme_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/schedule_flyme_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
      Progress track drawn with plain views instead of a ProgressBar.

      A ProgressBar in a RemoteViews is unreliable here: with the platform style the clip layer
      rendered at full width regardless of `progress`, and without the style Flyme fell back to an
      indeterminate spinner (a small circle). Both are the host's inflation behaviour, not our
      values. Two nested views sidestep it entirely: the track is a fixed rounded rectangle and the
      fill is a sibling whose width is set from code via setViewLayoutWidth.
    -->
    <FrameLayout
        android:id="@+id/schedule_flyme_progress_track"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/schedule_flyme_progress_track">

        <View
            android:id="@+id/schedule_flyme_progress_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/schedule_flyme_progress_fill" />
    </FrameLayout>

    <!-- Detail row: three equal columns, blank cells simply empty -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_flyme_label_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/schedule_flyme_value_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_flyme_label_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/schedule_flyme_value_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_flyme_label_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/schedule_flyme_value_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
