<?xml version="1.0" encoding="utf-8"?>
<!--
  Flyme live-notification expanded card.

  Three zones, matching the design reference:
    1. title row      course name (left) + remaining time or start clock (right)
    2. progress bar   8dp rounded, only meaningful while in class
    3. detail row     three equal columns: teacher / room / period (in class) or start (between)

  Flyme tints whatever it can from the wallpaper, so colours that must stay readable are set
  from code rather than left to the theme: the title uses the system onSurface colour and the
  right-hand status uses an explicit accent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/schedule_flyme_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/schedule_flyme_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
      Plain horizontal ProgressBar with the stock style.

      Three attempts to customise this were worse than leaving it alone:
        - platform style + custom progressDrawable: the clip layer drew at full width
        - no style at all: fell back to the indeterminate ring (the small circle seen on device)
        - FrameLayout track + plain View fill: the whole RemoteViews failed to inflate, blanking
          every card including the previously working ones
      So the stock style stays and the colour is left to the system. `progress` is driven with
      setInt("setProgress"), which is annotated @RemotableViewMethod; RemoteViews.setProgressBar is
      not, which is why every earlier value was silently discarded by the host.
    -->
    <ProgressBar
        android:id="@+id/schedule_flyme_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="100" />

    <!-- Detail row: three equal columns, blank cells simply empty -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_flyme_label_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/schedule_flyme_value_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_flyme_label_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/schedule_flyme_value_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_flyme_label_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/schedule_flyme_value_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
